---
layout: null
---
[
  {% assign valid_pages = "" | split: "" %}
  {% for page in site.pages %}
    {% if page.title and page.url != "/pdf-export.html" and page.url != "/print-export.html" %}
      {% assign valid_pages = valid_pages | push: page %}
    {% endif %}
  {% endfor %}
  {% for page in valid_pages %}
    {% if page.content contains "##" %}
      {% assign page_content = page.content | markdownify | strip_html | strip_newlines %}
    {% else %}
      {% assign page_content = page.content | strip_html | strip_newlines %}
    {% endif %}
    {
      "title": {{ page.title | jsonify }},
      "url": {{ page.url | jsonify }},
      "description": {{ page.description | default: "" | jsonify }},
      "content": {{ page_content | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
